# ─── Slack ───
SLACK_BOT_TOKEN=xoxb-...
# SLACK_SKIP_DMS=false
# SLACK_SKIP_FILES=false

# ─── Notion ───
NOTION_TOKEN=ntn_...

# ─── Linear ───
LINEAR_API_KEY=lin_api_...
# LINEAR_TEAM_KEYS=ENG,PROD
# LINEAR_INCLUDE_ARCHIVED=true
# LINEAR_DOWNLOAD_ATTACHMENTS=true

# ─── Gmail (OAuth2) ───
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# GMAIL_MAX_ATTACHMENT_MB=25
# GMAIL_INCLUDE_SPAM_TRASH=false
# GMAIL_INCLUDE_DRAFTS=false
# GMAIL_BATCH_SIZE=500
# GMAIL_CONCURRENCY=2

# ─── GOG (Gmail via gog CLI) ───
GOG_ACCOUNT=
# GOG_PATH=gog

# ─── Scheduling (optional) ───
# Path to a retrieval-skill checkout for vector indexing after sync.
# If unset, the indexing phase is skipped.
# RETRIEVAL_SKILL_DIR=/path/to/retrieval-skill
