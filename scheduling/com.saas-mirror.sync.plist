<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  saas-mirror: periodic sync + index
  
  Runs every 30 minutes. Syncs all SaaS adapters (Slack, Notion, Linear, Gmail),
  then incrementally re-indexes changed files into the retrieval-skill vector store.
  
  Install:
    ln -sf /path/to/saas-mirror/scheduling/com.saas-mirror.sync.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.saas-mirror.sync.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.saas-mirror.sync.plist
    rm ~/Library/LaunchAgents/com.saas-mirror.sync.plist
  
  Logs: /tmp/saas-mirror.log
  Status: launchctl list | grep saas-mirror
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.saas-mirror.sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>scheduling/sync-and-index.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/path/to/saas-mirror</string>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>StandardOutPath</key>
    <string>/tmp/saas-mirror.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/saas-mirror.log</string>
</dict>
</plist>
