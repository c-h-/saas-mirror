{
  "name": "saas-mirror",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local replication of SaaS data (Slack, Notion, Linear, Gmail) into Markdown files for embedding, RAG, and semantic search",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c-h-/saas-mirror.git"
  },
  "license": "MIT",
  "keywords": [
    "saas",
    "sync",
    "mirror",
    "rag",
    "embedding",
    "slack",
    "notion",
    "linear",
    "gmail",
    "markdown",
    "local-first"
  ],
  "workspaces": [
    "packages/*",
    "adapters/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core && tsc -b adapters/linear && tsc -b adapters/slack && tsc -b adapters/gmail && tsc -b adapters/notion && tsc -b adapters/gog",
    "typecheck": "tsc -b packages/core adapters/linear adapters/slack adapters/gmail adapters/notion adapters/gog",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "sync": "node --import tsx/esm packages/core/src/cli.ts sync",
    "sync:full": "node --import tsx/esm packages/core/src/cli.ts sync --full",
    "daemon": "node --import tsx/esm packages/core/src/cli.ts daemon"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.6.0",
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
